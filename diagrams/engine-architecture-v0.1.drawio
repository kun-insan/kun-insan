<mxfile host="app.diagrams.net"><diagram id="brain" name="Kun Insan Engine v0.1"><mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="كن إنسان — Engine Architecture (v0.1)&#xa;One engine, many instances: the founder&#x27;s instance is user #1 · every user gets the same engine, delivered empty + guardrails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#1f2937;fontSize=14;fontStyle=1;arcSize=8;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="50" as="geometry"/></mxCell><mxCell id="n3" value="🛡 GUARDRAILS — fixed, never change whatever it learns&#xa;Never guess → say &quot;I don&#x27;t know&quot; + ask: tell me 1-2-3 / give me access to 1-2-3 / look at 1-2-3 · always back to source · user owns &amp; sees everything · legal consent (data · publishing · Feel AI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=12;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="1660" height="60" as="geometry"/></mxCell><mxCell id="n4" value="1 · INPUTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=14;fontStyle=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="260" height="520" as="geometry"/></mxCell><mxCell id="n5" value="🎙 Voice notes (feeling, not just words)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="35" y="185" width="230" height="45" as="geometry"/></mxCell><mxCell id="n6" value="💬 Text / chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeome